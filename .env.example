# ===== 讯飞星火 MaaS 文本对话工作台 · 环境变量示例 =====
# 用法：复制本文件为 .env 并填写下方值；.env 已在 .gitignore 中，不会提交/分发
# 优先级：后台管理（data/db.json）中已填写的值 > 本文件 > 内置默认值
#
# ---------- 必填 ----------
# API Key：讯飞 MaaS 控制台 →「API调用 / APIKEY管理」获取，形如 ak-f30b1****fc84b82e86a
XFYUN_API_KEY=
# 模型 ID：控制台 →「API调用」获取，例如 spark-x2.6 / xopglm53
XFYUN_MODEL=spark-x2.6

# ---------- 可选 ----------
# 兼容讯飞官方文档示例中的变量名（与 XFYUN_API_KEY 等价，二选一即可）
SPARK_API_PASSWORD=
# 接口地址，一般无需修改（默认 https://maas-api.cn-huabei-1.xf-yun.com）
XFYUN_BASE_URL=
# 环境变量配置在后台列表中显示的名称
XFYUN_CONFIG_NAME=环境变量配置（.env）
# 单次请求超时（毫秒，默认 120000）
XFYUN_TIMEOUT_MS=120000
# 网络错误 / 上游 5xx 的重试次数（默认 1，最大 3；4xx 不重试）
XFYUN_MAX_RETRIES=1
# 服务端口（默认 4000）
PORT=4000

# ---------- 后台管理密码（/admin） ----------
# 初始密码：仅在首次启动（db.json 无密码哈希）时生效；不设则随机生成并打印到控制台（仅一次）
ADMIN_PASSWORD=
# 设为 1 可在重启时强制重置密码（配合 ADMIN_PASSWORD 指定新密码，否则再生成随机密码）
ADMIN_PASSWORD_RESET=0
# 会话有效期（小时，默认 12；修改密码后所有会话失效需重新登录）
ADMIN_SESSION_TTL_HOURS=12
